# ===================== SERVER =====================
PORT=3000
JWT_SECRET=ganti-dengan-string-random-panjang-min-32-karakter-bebas
JWT_EXPIRES=7d

# ===================== MIDTRANS =====================
# Dapatkan dari: https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ===================== ADMIN =====================
# Token untuk login ke admin.html
ADMIN_TOKEN=admin123

# ===================== WAHA (WhatsApp) =====================
# Kalau belum setup WAHA, biarkan nilai default dulu
WAHA_URL=http://localhost:3001
WAHA_API_KEY=waha-secret-key-anda
WAHA_SESSION=default
